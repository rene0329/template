{
  "name": "virtual-data-center-scheduler",
  "productName": "虚拟数据中心原位调度子系统",
  "version": "4.4.0",
  "main": "electron/main.js",
  "description": "虚拟数据中心原位调度子系统桌面客户端",
  "author": "miiyakii",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "dev:web": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "dev:electron": "wait-on http://127.0.0.1:9528 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:9528 electron .",
    "electron:dev": "concurrently -k \"pnpm:dev:web\" \"pnpm:dev:electron\"",
    "build:prod": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "build:stage": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode staging",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "configure:default": "node scripts/write-default-config.js",
    "electron:package": "pnpm run build && electron-forge package",
    "electron:make": "pnpm run build && electron-forge make",
    "preview": "node build/index.js --preview",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "lint": "eslint --ext .js,.vue src",
    "test:unit": "jest --clearCache && vue-cli-service test:unit",
    "test:ci": "npm run lint && npm run test:unit"
  },
  "dependencies": {
    "axios": "0.18.1",
    "bpmn-js": "^13.2.2",
    "codemirror": "^5.65.14",
    "core-js": "3.6.5",
    "d3": "^7.8.3",
    "echarts": "^4.9.0",
    "element-ui": "^2.15.13",
    "highlight.js": "^11.12.0",
    "jeeplus-bpmn": "^6.0.10",
    "js-cookie": "2.2.0",
    "jsonlint-mod": "^1.7.6",
    "normalize.css": "7.0.0",
    "nprogress": "0.2.0",
    "path-to-regexp": "2.4.0",
    "svg-baker-runtime": "^1.4.7",
    "vue": "2.6.10",
    "vue-codemirror": "^4.0.6",
    "vue-count-to": "^1.0.13",
    "vue-highlightjs": "^1.3.3",
    "vue-router": "3.0.6",
    "vuex": "3.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@vue/cli-plugin-babel": "4.4.4",
    "@vue/cli-plugin-eslint": "4.4.4",
    "@vue/cli-plugin-unit-jest": "4.4.4",
    "@vue/cli-service": "4.4.4",
    "@vue/test-utils": "1.0.0-beta.29",
    "autoprefixer": "9.5.1",
    "babel-eslint": "10.1.0",
    "babel-jest": "23.6.0",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "chalk": "2.4.2",
    "concurrently": "^10.0.5",
    "connect": "3.6.6",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "eslint": "6.7.2",
    "eslint-plugin-vue": "6.2.2",
    "html-webpack-plugin": "3.2.0",
    "less": "^4.4.1",
    "less-loader": "^7.3.0",
    "mockjs": "1.0.1-beta3",
    "monaco-editor": "^0.29.1",
    "monaco-editor-webpack-plugin": "^5.0.0",
    "runjs": "4.3.2",
    "sass": "1.26.8",
    "sass-loader": "8.0.2",
    "script-ext-html-webpack-plugin": "2.1.3",
    "serve-static": "1.13.2",
    "svg-sprite-loader": "4.1.3",
    "svgo": "1.2.2",
    "vue-template-compiler": "2.6.10",
    "wait-on": "^9.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.19.0"
}
